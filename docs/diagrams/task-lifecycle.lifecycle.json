{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "TaskEscrow · On-chain State Machine",
    "subtitle": "7 persisted task states · exact transitions from TaskEscrow.sol",
    "output": "task-lifecycle.html"
  },
  "lanes": [
    { "id": "main", "label": "Funded Task" },
    { "id": "dispute", "label": "Dispute + Human Review" },
    { "id": "terminal", "label": "Terminal Outcomes" }
  ],
  "states": [
    { "id": "created", "type": "start", "label": "Created", "lane": "main", "col": 0, "step": "01", "sublabel": "funds locked · agent optional", "tag": "createTask" },
    { "id": "delivered", "type": "active", "label": "Delivered", "lane": "main", "col": 2, "step": "02", "sublabel": "deliveryHash committed", "tag": "submitDelivery" },
    { "id": "disputed", "type": "active", "label": "Disputed", "lane": "dispute", "col": 1, "sublabel": "client or agent opens case", "tag": "openDispute" },
    { "id": "review", "type": "waiting", "label": "ManualReview", "lane": "dispute", "col": 2, "sublabel": "subjective funds frozen", "tag": "frozen > 0" },
    { "id": "refunded", "type": "success", "label": "Refunded", "lane": "terminal", "col": 0, "sublabel": "client paid or credited" },
    { "id": "accepted", "type": "success", "label": "Accepted", "lane": "terminal", "col": 1, "sublabel": "agent paid or credited" },
    { "id": "settled", "type": "success", "label": "Settled", "lane": "terminal", "col": 2, "sublabel": "allocations paid or credited" }
  ],
  "transitions": [
    { "from": "created", "to": "delivered", "variant": "emphasis" },
    { "from": "created", "to": "refunded", "variant": "dashed", "fromSide": "bottom", "toSide": "left", "via": [[20, 188], [20, 479]] },
    { "from": "delivered", "to": "accepted", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "delivered", "to": "disputed", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "disputed", "to": "review", "variant": "security", "fromSide": "top", "toSide": "top", "route": "top-channel" },
    { "from": "disputed", "to": "settled", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "review", "to": "settled", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Happy path", "items": ["Created → Delivered → Accepted", "assignAgent changes the agent field but remains Created"] },
    { "dot": "amber", "title": "Dispute path", "items": ["settle(frozen=0) → Settled", "settle(frozen>0) → ManualReview → releaseFrozen → Settled"] },
    { "dot": "rose", "title": "Expiry + payments", "items": ["refundExpiredTask: Created → Refunded after deadline", "Failed push payments become claimable for later withdrawal"] }
  ]
}