{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "End-to-End Task Creation Flow",
    "subtitle": "User input → Moss simulation → Wallet signing → TaskCreated on Monad Testnet",
    "output": "e2e-flow.html"
  },
  "lanes": [
    { "id": "user", "label": "User / Wallet" },
    { "id": "app", "label": "Silicon App (Server)" },
    { "id": "moss", "label": "Moss + Monad Testnet" }
  ],
  "phases": [
    { "id": "prep", "label": "1. Prepare", "fromCol": 0, "toCol": 1 },
    { "id": "sim", "label": "2. Moss Simulate & E3", "fromCol": 2, "toCol": 3 },
    { "id": "sign", "label": "3. Wallet Sign & Confirm", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["input", "normalize", "mossSim", "verifyE3", "sign", "bind"],
  "nodes": [
    { "id": "input", "lane": "user", "col": 0, "type": "frontend", "label": "User Input", "sublabel": "Task + MON amount" },
    { "id": "normalize", "lane": "app", "col": 1, "type": "backend", "label": "Prepare Task", "sublabel": "Requirements → MossBridge", "width": 110 },
    { "id": "mossSim", "lane": "moss", "col": 2, "type": "cloud", "label": "Moss Simulate", "sublabel": "Capability → tx → TraceCall", "tag": "debug_traceCall" },
    { "id": "verifyE3", "lane": "app", "col": 3, "type": "security", "label": "Verify & Build E3", "sublabel": "No warnings → canon. evidence", "tag": "gate", "width": 120 },
    { "id": "sign", "lane": "user", "col": 4, "type": "security", "label": "Sign & Broadcast", "sublabel": "Same tx → wallet confirms", "width": 120 },
    { "id": "bind", "lane": "app", "col": 5, "type": "backend", "label": "Bind E3", "sublabel": "Tx receipt → evidence", "width": 100 }
  ],
  "edges": [
    { "from": "input", "to": "normalize", "variant": "emphasis" },
    { "from": "normalize", "to": "mossSim", "fromSide": "bottom", "toSide": "top", "route": "drop" },
    { "from": "mossSim", "to": "verifyE3" },
    { "from": "verifyE3", "to": "sign" },
    { "from": "sign", "to": "bind", "fromSide": "bottom", "toSide": "top", "route": "drop" }
  ],
  "groups": [
    { "id": "moss-block", "label": "Moss Simulation & E3", "lane": "moss", "fromCol": 2, "toCol": 3, "variant": "emphasis" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Pre-Sign", "items": ["Steps 1–4 run before any wallet approval", "E3 pre-sign evidence generated with canonical hash", "Simulation with warnings = BLOCK the flow"] },
    { "dot": "amber", "title": "Sign Boundary", "items": ["Step 5: wallet is the only signing boundary", "Moss never signs, never broadcasts"] },
    { "dot": "violet", "title": "Post-Sign", "items": ["Step 6: real tx hash bound to E3 evidence", "TaskCreated event → case responsibility anchor"] }
  ]
}
