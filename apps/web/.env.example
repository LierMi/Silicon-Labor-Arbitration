# ── 前端数据源模式 ──────────────────────────────────────────
# mock（默认）：freshPotatoCase() 固化演示数据，isMock=true，UI 标注 DEMO。
# live：从 Monad Testnet TaskEscrow 读取真实任务状态，isMock=false，UI 标注 HYBRID
#   （链上状态真实 + 证据叙事为演示数据；有真实证据映射后升级为 LIVE）。
#   live 读取失败自动回退 mock（诚实标注，不伪装真实数据）。
NEXT_PUBLIC_CASE_SOURCE=mock

# live 模式下要展示的任务（0x 开头 32 字节）。
# 缺省时自动扫描链上最近 20000 块的最新 TaskCreated 事件；
# 更早的任务请显式指定 taskId。
NEXT_PUBLIC_LIVE_TASK_ID=

# ── 演示自动签名 API ─────────────────────────────────────────
# /api/demo/agent-action 的安全开关。默认关闭（403）。
# 本地演示/受控演示环境设置为 true 才启用；生产必须保持关闭，
# 或仅对受信任的演示部署开启（Agent 偏移锁定 999-1003，进程内限流）。
DEMO_AGENT_ACTION_ENABLED=false
