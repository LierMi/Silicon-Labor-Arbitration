# ---- 密钥与环境变量（通配，任何形态都不提交）----
.env*
!.env.example
*.key
*.pem
secrets/

# ---- 依赖 ----
node_modules
.pnpm-store/

# ---- 构建产物 ----
.next/
out/
dist/
build/

# ---- Foundry ----
contracts/out/
contracts/cache/
contracts/broadcast/
# Foundry 依赖。forge-std 是 git submodule（见 .gitmodules），必须入库——
# 否则干净 clone 下 script/DeployTaskEscrow.s.sol 编译不了。
# 其余手动装的库仍然忽略。
contracts/lib/*
!contracts/lib/forge-std
cache/

# ---- 日志 ----
*.log
npm-debug.log*
pnpm-debug.log*

# ---- 编辑器与系统 ----
.DS_Store
.vscode/
.idea/
*.swp

