# Monad Testnet public RPC (chain ID 10143)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Testnet deployer wallet. Never use a wallet that holds mainnet assets.
DEPLOYER_ADDRESS=0xYOUR_DEPLOYER_ADDRESS
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# Trusted witness authorized to submit evidence-linked settlements and human-reviewed releases.
SETTLEMENT_AUTHORITY_ADDRESS=0xYOUR_TESTNET_SETTLEMENT_AUTHORITY

# Independent recovery role; it must not equal SETTLEMENT_AUTHORITY_ADDRESS.
AUTHORITY_ADMIN_ADDRESS=0xYOUR_TESTNET_AUTHORITY_ADMIN
