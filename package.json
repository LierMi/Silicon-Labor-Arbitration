{
  "name": "silicon-labor-arbitration",
  "version": "0.1.0",
  "private": true,
  "description": "硅基劳动仲裁院 · Silicon Labor Arbitration",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "postinstall": "git submodule update --init --recursive",
    "build:moss": "pnpm -r --workspace-concurrency=1 --filter \"@themoss/protocol-silicon-arbitration...\" --filter \"@themoss/simulator...\" --filter \"@themoss/system...\" build",
    "typecheck": "pnpm build:moss && pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
    "typecheck:only": "pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
    "test:contracts": "cd contracts && forge test",
    "test": "pnpm build:moss && pnpm -r --filter \"./packages/*\" test",
    "test:only": "pnpm -r --filter \"./packages/*\" test",
    "verify": "pnpm build:moss && pnpm typecheck:only && pnpm test:only"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
