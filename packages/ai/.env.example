# ── Gonka（推荐：新账号有一次性 $20 免费额度）────────────────
GONKA_API_KEY=sk-xxxxxx
# 可选，默认 https://api.gonkarouter.io
# ⚠️ 写到主机名为止即可，SDK 会自己拼 /v1/messages
GONKA_BASE_URL=https://api.gonkarouter.io
# 可选，默认 moonshotai/Kimi-K2.6
GONKA_MODEL=moonshotai/Kimi-K2.6

# ── Anthropic（备选）───────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-xxxxxx
# ANTHROPIC_MODEL=claude-opus-5
