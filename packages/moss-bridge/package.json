  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@sla/domain": "workspace:*",
    "@themoss/core": "workspace:*",
    "@themoss/protocol-silicon-arbitration": "workspace:*",
    "@themoss/simulator": "workspace:*",
    "@themoss/system": "workspace:*",
    "viem": "^2.54.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "~5.9.0"
  }
}
